{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker project Cloudflare's GitHub integration deploys into. In those
  // builds Wrangler uses the project's name regardless; keeping the two equal
  // means a deploy by hand lands in the same Worker.
  "name": "painel",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Cloudflare creates the DNS record and certificate on deploy; orma.arq.br
  // has to be a zone on the same Cloudflare account.
  "routes": [{ "pattern": "painel.orma.arq.br", "custom_domain": true }],
  // Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are deliberately not
  // listed under "secrets.required": Wrangler then refuses a Worker's very first
  // deploy, before there is a Worker to set them on. They are typed in
  // src/env.d.ts instead, and set in the dashboard (Settings → Variables and
  // secrets) and in .dev.vars locally.
  "d1_databases": [
    {
      "binding": "DB",
      // Created by hand in Eastern North America (`wrangler d1 create
      // orma-painel --location enam`): there is no South American region, and
      // a database can't be moved once created. Pinned by ID, because without
      // one Wrangler reuses whatever database the Worker was last attached to,
      // or creates a new one wherever the build happens to run.
      "database_id": "90ea6b4a-79aa-448e-a94a-4f32e662e643",
      "database_name": "orma-painel",
      "migrations_dir": "migrations",
    },
  ],
}
