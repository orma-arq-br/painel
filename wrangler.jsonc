{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker project Cloudflare's GitHub integration deploys
  // into. A different name makes every build publish a second Worker
  // alongside it, one without the secrets set in the dashboard.
  "name": "painel",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Cloudflare creates the DNS record and certificate on deploy; orma.arq.br
  // has to be a zone on the same Cloudflare account.
  "routes": [{ "pattern": "painel.orma.arq.br", "custom_domain": true }],
  // Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are deliberately not
  // listed under "secrets.required": Wrangler then refuses a Worker's very first
  // deploy, before there is a Worker to set them on. They are typed in
  // src/env.d.ts instead, and set in the dashboard (Settings → Variables and
  // secrets) and in .dev.vars locally.
  "d1_databases": [
    {
      "binding": "DB",
      // Found by name, so no database_id. Created by hand once, BEFORE the
      // first deploy, with `wrangler d1 create orma-painel --location enam`
      // (or in the dashboard, choosing Eastern North America). If a deploy
      // finds no database it creates one itself, but without a location hint,
      // and Cloudflare then puts it wherever the build happened to run
      // (it once landed in Asia Pacific). There is no South American region;
      // Eastern North America is the closest to Porto Alegre. A database can't
      // be moved after it is created.
      "database_name": "orma-painel",
      "migrations_dir": "migrations",
    },
  ],
}
